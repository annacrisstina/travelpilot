# =====================================================================
# TravelPilot configuration
#
# Local mode (recommended, default): the settings below run entirely
# locally — Markdown knowledge base from the ./knowledge directory and
# the Gemini API with a free API key. No Google Cloud project or
# bucket is required.
#
# Google Cloud mode (optional): see the example at the bottom of this
# file for Vertex AI and Cloud Storage configuration.
# =====================================================================

# ---------------------------------------------------------------------
# Agent model
# ---------------------------------------------------------------------
MODEL=gemini-2.5-flash

# Model backend:
#   FALSE (default) - Gemini API with an API key from Google AI Studio.
#                     Get a free key at https://aistudio.google.com/apikey
#   TRUE            - Vertex AI. Requires GOOGLE_CLOUD_PROJECT and
#                     Application Default Credentials
#                     (gcloud auth application-default login).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Replace with your own Google AI Studio API key.
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ---------------------------------------------------------------------
# Knowledge base
# ---------------------------------------------------------------------
# Where the travel guides are read from:
#   local (default) - Markdown files in LOCAL_KNOWLEDGE_DIRECTORY.
#   cloud           - Markdown objects in the KNOWLEDGE_BUCKET
#                     Google Cloud Storage bucket.
KNOWLEDGE_SOURCE=local

# Used only when KNOWLEDGE_SOURCE=local.
# Relative paths are resolved from the project root.
LOCAL_KNOWLEDGE_DIRECTORY=knowledge

# ---------------------------------------------------------------------
# Google Cloud (optional)
# ---------------------------------------------------------------------
# Required only when GOOGLE_GENAI_USE_VERTEXAI=TRUE or
# KNOWLEDGE_SOURCE=cloud.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Required only when KNOWLEDGE_SOURCE=cloud.
# Populate the bucket with: python scripts/upload_knowledge.py
KNOWLEDGE_BUCKET=

# =====================================================================
# Example: Google Cloud mode (optional)
# =====================================================================
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=my-gcp-project
# GOOGLE_CLOUD_LOCATION=global
# KNOWLEDGE_SOURCE=cloud
# KNOWLEDGE_BUCKET=my-gcp-project-travelpilot-kb
